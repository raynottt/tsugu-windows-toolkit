 <UserControl x:Class="TidyWindow.Next.Desktop.SuggestedView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 HorizontalContentAlignment="Stretch">
  <UserControl.Resources>
   <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
     <ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" />
     <ResourceDictionary Source="ms-appx:///Styles/PageStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
   </ResourceDictionary>
  </UserControl.Resources>
  <Grid RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Spacing="4" VerticalAlignment="Center">
     <TextBlock Text="Suggested apps" Style="{StaticResource PageTitle}" />
     <TextBlock Text="A hand-picked shelf of useful Windows apps, open-source projects and tools." Style="{StaticResource Muted}" />
    </StackPanel>
    <Border Grid.Column="1" Background="{ThemeResource BadgeBrush}" CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="{ThemeResource MutedBrush}" />
      <TextBlock Text="CURATED" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource MutedBrush}" />
     </StackPanel>
    </Border>
   </Grid>

   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
    <Grid ColumnSpacing="18">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="12" Background="#EDE9FE" VerticalAlignment="Center">
      <FontIcon Glyph="&#xE7B8;" FontSize="21" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
      <TextBlock Text="Your next setup, without the browser hunt" Style="{StaticResource ItemTitle}" />
      <TextBlock Text="WinGet apps are added to TSUGU's install queue. GitHub and vendor entries open their official release or download page so you can review the installer before running it." Style="{StaticResource Muted}" TextWrapping="Wrap" />
     </StackPanel>
     <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
      <TextBlock Text="23" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
      <TextBlock Text="SUGGESTIONS" FontSize="9" FontWeight="SemiBold" CharacterSpacing="85" Foreground="{ThemeResource MutedBrush}" />
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="2" ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
    <TextBox x:Name="SearchBox" PlaceholderText="Search suggested apps" Height="38" TextChanged="FilterChanged" AutomationProperties.Name="Search suggested apps" />
    <ComboBox x:Name="CategoryPicker" Grid.Column="1" MinWidth="190" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter suggested apps by category" />
   </Grid>

   <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
    <StackPanel Spacing="9" Padding="0,0,0,12">
     <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="12" />
     <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False" AutomationProperties.Name="Suggested app catalog">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="9" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Style="{StaticResource Card}" Padding="14">
         <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="42" Height="42" CornerRadius="11" Background="{ThemeResource BadgeBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" VerticalAlignment="Top">
           <FontIcon Glyph="{Binding Glyph}" FontSize="18" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" VerticalAlignment="Center" />
            <Border Background="{ThemeResource BadgeBrush}" CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
             <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{ThemeResource MutedBrush}" />
            </Border>
           </StackPanel>
           <TextBlock Text="{Binding Description}" Style="{StaticResource RowSub}" TextWrapping="Wrap" MaxLines="2" />
           <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource MutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
           <Button Content="{Binding ActionLabel}" Click="PrimaryClick" Padding="13,7" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{Binding ActionAutomationName}" />
           <Button Content="Source" Click="SourceClick" Visibility="{Binding SourceVisibility}" Padding="11,7" FontSize="12" AutomationProperties.Name="{Binding SourceAutomationName}" />
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="6" Padding="20,44">
      <TextBlock Text="No matching suggestions" Style="{StaticResource EmptyTitle}" />
      <TextBlock Text="Try a different search or category." Style="{StaticResource Muted}" />
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </UserControl>
