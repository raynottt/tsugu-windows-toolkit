<UserControl x:Class="TidyWindow.Next.Desktop.SuggestedView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" />
    <ResourceDictionary Source="ms-appx:///Styles/PageStyles.xaml" />
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid RowSpacing="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
  </Grid.RowDefinitions>

  <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
    <StackPanel Padding="24,22" Spacing="10">
     <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
      <TextBlock Text="TSUGU  /  APP LIBRARY" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource MutedBrush}" />
     </Border>
     <TextBlock Text="Your apps. One place." FontSize="27" FontWeight="SemiBold" CharacterSpacing="-25" />
     <TextBlock Text="Install without the browser hunt. WinGet stays in its native queue, GitHub apps install from the latest Windows release, and vendor downloads come from official hosts." Style="{StaticResource Muted}" MaxWidth="720" TextWrapping="Wrap" />
     <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
      <Border Background="{ThemeResource BadgeBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="WINGET" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource MutedBrush}" /></Border>
      <Border Background="{ThemeResource BadgeBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="GITHUB RELEASES" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource MutedBrush}" /></Border>
      <Border Background="{ThemeResource BadgeBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="OFFICIAL DOWNLOADS" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource MutedBrush}" /></Border>
     </StackPanel>
    </StackPanel>
    <Border Grid.Column="1" Background="{ThemeResource BadgeBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,0" CornerRadius="0,12,12,0" Padding="18" VerticalAlignment="Stretch">
     <StackPanel VerticalAlignment="Center" Spacing="3">
      <FontIcon Glyph="&#xE734;" FontSize="22" Foreground="{ThemeResource MutedBrush}" />
      <TextBlock Text="{Binding TotalSuggestions}" FontSize="34" FontWeight="SemiBold" CharacterSpacing="-30" />
      <TextBlock Text="CURATED APPS" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource MutedBrush}" />
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <Grid Grid.Row="1" ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" PlaceholderText="Search apps, tools or categories…" Height="40" TextChanged="FilterChanged" AutomationProperties.Name="Search suggested apps" />
   <ComboBox x:Name="CategoryPicker" Grid.Column="1" MinWidth="190" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter suggested apps by category" />
  </Grid>

  <Grid Grid.Row="2" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
   <TextBlock Grid.Column="1" Text="LATEST WINDOWS BUILDS" FontSize="9" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
  </Grid>

  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
   <StackPanel Spacing="10" Padding="0,0,0,12">
    <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False" AutomationProperties.Name="Suggested app catalog">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Style="{StaticResource Card}" Padding="15" CornerRadius="10">
        <Grid ColumnSpacing="15">
         <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <Border Width="46" Height="46" CornerRadius="11" Background="{ThemeResource BadgeBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" VerticalAlignment="Top">
          <FontIcon Glyph="{Binding Glyph}" FontSize="19" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
         </Border>
         <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="9">
           <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" VerticalAlignment="Center" />
           <Border Background="{ThemeResource BadgeBrush}" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{ThemeResource MutedBrush}" />
           </Border>
          </StackPanel>
          <TextBlock Text="{Binding Description}" Style="{StaticResource RowSub}" TextWrapping="Wrap" MaxLines="2" />
          <TextBlock Text="{Binding SourceLabel}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
         </StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{Binding ActionLabel}" Click="PrimaryClick" Padding="13,7" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{Binding ActionAutomationName}" />
          <Button Content="Source" Click="SourceClick" Visibility="{Binding SourceVisibility}" Padding="11,7" FontSize="12" AutomationProperties.Name="{Binding SourceAutomationName}" />
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="6" Padding="20,44">
     <TextBlock Text="No matching suggestions" Style="{StaticResource EmptyTitle}" />
     <TextBlock Text="Try a different search or category." Style="{StaticResource Muted}" />
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
